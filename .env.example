# Wi-Fi access point credentials for the panel.
#
# Copy this file to .env and edit it:
#     cp .env.example .env
#
# .env is git-ignored, so your password is not published. If .env is missing the
# build falls back to the defaults shown here.
#
# Keep to plain characters (letters, digits, and simple punctuation): the value
# is passed to the compiler, so avoid double quotes and semicolons.

AP_SSID=Visakha Lamp
AP_PASS=12345678
